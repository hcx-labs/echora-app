# Generated by scripts/export-runtime-settings.py. Do not edit defaults here.
# Copy selected lines into .env and remove the leading comment marker.
# All entries are commented so this catalog does not replace Compose defaults.
# Secret values are blank. See docs/runtime-settings.md for deployment details.

# --- DatabaseConfig: The PostgreSQL database every Echora process shares.
#   PostgreSQL URL.
# DATABASE_URL=
#   SQLAlchemy pool size per process.
# DB_POOL_SIZE=10
#   Connections beyond the pool size.
# DB_MAX_OVERFLOW=20

# --- QueueConfig: Leases, retries and attempts of durable jobs.
#   How long a claim lasts.
#   Also read as ECHORA_WORKER_LEASE_SECONDS (deprecated).
# ECHORA_JOB_LEASE_SECONDS=120
#   First retry delay; doubles per attempt.
# ECHORA_JOB_RETRY_BASE_SECONDS=2
#   Longest retry delay.
# ECHORA_JOB_RETRY_MAX_SECONDS=60
#   Attempts before a job fails.
# ECHORA_JOB_MAX_ATTEMPTS=3

# --- NavidromeConfig: HTTP limits of the Navidrome client, and the batch audio cache.
#   Connect and API timeout.
# ECHORA_NAVIDROME_TIMEOUT_SECONDS=30
#   Audio download read timeout.
# ECHORA_NAVIDROME_READ_TIMEOUT_SECONDS=300
# ECHORA_NAVIDROME_MAX_CONNECTIONS=100
# ECHORA_NAVIDROME_MAX_KEEPALIVE_CONNECTIONS=30
# ECHORA_NAVIDROME_KEEPALIVE_EXPIRY_SECONDS=30
#   Disk a batch may use for downloaded songs (0: no cache).
#   Also read as ECHORA_AUDIO_CACHE_BYTES (deprecated).
# ECHORA_NAVIDROME_AUDIO_CACHE_BYTES=2147483648

# --- LastfmConfig: Last.fm requests.
#   Checking an API key.
# ECHORA_LASTFM_VALIDATION_TIMEOUT_SECONDS=15
#   Reading listening history.
#   Also read as ECHORA_LISTENING_HISTORY_TIMEOUT_SECONDS (deprecated).
# ECHORA_LASTFM_HISTORY_TIMEOUT_SECONDS=20

# --- CredentialsConfig: The key that encrypts stored credentials (Navidrome passwords, provider keys).
#   Fernet key.
#   Also read as CREDENTIAL_ENCRYPTION_KEY (deprecated).
# ECHORA_CREDENTIAL_ENCRYPTION_KEY=

# --- EmbeddingConfig: Audio (MuQ-MuLan, MERT) and lyrics (BGE-M3) embedding models, pinned by revision.
#   Also read as MUQ_MODEL_ID (deprecated).
# ECHORA_EMBEDDING_MUQ_MODEL_ID=OpenMuQ/MuQ-MuLan-large
#   Also read as MUQ_REVISION (deprecated).
# ECHORA_EMBEDDING_MUQ_REVISION=2e01c796b71dca71b45251384c04cd7b237c9020
#   Also read as MERT_MODEL_ID (deprecated).
# ECHORA_EMBEDDING_MERT_MODEL_ID=m-a-p/MERT-v1-95M
#   Also read as MERT_REVISION (deprecated).
# ECHORA_EMBEDDING_MERT_REVISION=12af15fef9d0ac838c3f475bfbbf26d2060dd4f5
#   Also read as LYRICS_MODEL_ID (deprecated).
# ECHORA_EMBEDDING_LYRICS_MODEL_ID=BAAI/bge-m3
#   Also read as LYRICS_REVISION (deprecated).
# ECHORA_EMBEDDING_LYRICS_REVISION=5617a9f61b028005a4858fdac845db406aefb181
#   Lyric windows per batch.
#   Also read as ECHORA_LYRICS_WINDOW_BATCH_SIZE (deprecated).
# ECHORA_EMBEDDING_LYRICS_WINDOW_BATCH_SIZE=2
#   Songs per lyrics batch.
#   Also read as ECHORA_LYRICS_TRACK_BATCH_SIZE (deprecated).
# ECHORA_EMBEDDING_LYRICS_TRACK_BATCH_SIZE=8

# --- LanguageConfig: Language identification model files.
#   Also read as LID_MODEL_PATH (deprecated).
# ECHORA_LANGUAGE_LID_MODEL_PATH=/models/lid.176.bin
#   Also read as INDICLID_FTR_PATH (deprecated).
# ECHORA_LANGUAGE_INDICLID_FTR_PATH=/models/indiclid-ftr.bin

# --- MotionArtworkConfig: Motion artwork videos and their models. The worker renders them; the backend serves them.
#   Rendered videos (not model files).
# ECHORA_MOTION_ARTWORK_DIR=/data/motion-artwork
#   Download the LTX-2.5 and Gemma files (about 44 GB) with the models.
# ECHORA_MOTION_ARTWORK_MODELS=false
# ECHORA_MOTION_ARTWORK_RENDER_TIMEOUT_SECONDS=3600
# ECHORA_MOTION_ARTWORK_POLL_SECONDS=2

# --- WorkerConfig: Polling, heartbeats and batch size of a worker process.
#   Wait between empty claims.
# ECHORA_WORKER_POLL_SECONDS=2
#   Under half the job lease.
# ECHORA_WORKER_HEARTBEAT_SECONDS=10
# ECHORA_WORKER_SCHEDULE_CHECK_SECONDS=30
# ECHORA_WORKER_CLEANUP_INTERVAL_SECONDS=60
# ECHORA_WORKER_SHUTDOWN_GRACE_SECONDS=5
#   Songs per analysis batch.
#   Also read as ECHORA_BATCH_SIZE (deprecated).
# ECHORA_WORKER_BATCH_SIZE=128

# --- LibraryConfig: Fingerprinting and source freshness during sync.
#   Also read as ECHORA_FINGERPRINT_TIMEOUT_SECONDS (deprecated).
# ECHORA_LIBRARY_FINGERPRINT_TIMEOUT_SECONDS=120
#   Revalidate a song's source after this long (0: on every full sync).
#   Also read as ECHORA_SOURCE_RECHECK_SECONDS (deprecated).
# ECHORA_LIBRARY_SOURCE_RECHECK_SECONDS=0

# --- PreprocessConfig: The content-addressed cache of decoded and separated audio.
# ECHORA_PREPROCESS_DIR=/data/preprocessed
#   Cache size (0: no limit).
# ECHORA_PREPROCESS_MAX_BYTES=21474836480
# ECHORA_PREPROCESS_TTL_SECONDS=604800.0
# ECHORA_PREPROCESS_LOCK_TIMEOUT_SECONDS=1800
# ECHORA_PREPROCESS_LOCK_POLL_SECONDS=0.05

# --- ModelsConfig: Where downloaded model files live, beyond the Hugging Face cache.
#   Also read as ESSENTIA_MODELS_DIR (deprecated).
# ECHORA_MODELS_ESSENTIA_DIR=/data/models/essentia

# --- MelodyConfig: Hum search corpus building and queries.
#   Threads scoring one query.
# ECHORA_HUM_MAX_WORKERS=16
#   Also read as HUM_DIAGNOSTIC_DIR (deprecated).
# ECHORA_HUM_DIAGNOSTIC_DIR=/models/torch/hum-diagnostics

# --- FusionConfig: Weights of lyrics and audio in the fused track vector.
#   Also read as SEMANTIC_FUSION_WEIGHT_LYRICS (deprecated).
# ECHORA_FUSION_WEIGHT_LYRICS=0.75
#   Also read as SEMANTIC_FUSION_WEIGHT_AUDIO (deprecated).
# ECHORA_FUSION_WEIGHT_AUDIO=0.25

# --- RemoteConfig: The image and GPU of the deployed Modal app.
#   Release images set the GPU image of their own version.
# ECHORA_MODAL_IMAGE=ghcr.io/hackslashx/echora-analysis-gpu:latest
#   Set by the worker when it deploys.
# ECHORA_MODAL_GPU=L40S

# --- ComfyUIConfig: The embedded ComfyUI, which the worker starts only while a batch renders loops.
# ECHORA_COMFYUI_DIR=/opt/comfyui
# ECHORA_COMFYUI_PYTHON=/opt/comfyui-venv/bin/python
# ECHORA_COMFYUI_STARTUP_TIMEOUT_SECONDS=300
#   An already running ComfyUI instead of the embedded one (blank: embedded).
# ECHORA_COMFYUI_URL=

# --- CurationConfig: The scheduled worker's curation refreshes.
#   Due curations queued per check.
# ECHORA_CURATION_DUE_LIMIT=100

# --- TranscriptionConfig: The MOSS checkpoint that transcribes lyrics. Unset: AI lyrics are unavailable.
#   Also read as MOSS_MODEL_ID (deprecated).
# ECHORA_TRANSCRIPTION_MOSS_MODEL_ID=
#   40-character commit.
#   Also read as MOSS_REVISION (deprecated).
# ECHORA_TRANSCRIPTION_MOSS_REVISION=

# --- KaraConfig: The aligner model and decoder. The defaults are what the model was evaluated with.
#   Also read as FA_KARA_MODEL_ID (deprecated).
# ECHORA_KARA_MODEL_ID=hcxlabs/echora-kara-700m-muq
#   Also read as FA_KARA_REVISION (deprecated).
# ECHORA_KARA_REVISION=7c0cda150c8be886ed5ff2f903460f112cf4c7a2
#   A local checkpoint directory; overrides the model ID snapshot.
#   Also read as FA_KARA_MODEL_PATH (deprecated).
# ECHORA_KARA_MODEL_PATH=
#   Also read as FA_KARA_AUDIO_SPEED (deprecated).
# ECHORA_KARA_AUDIO_SPEED=1.0
#   Minimum letter duration on the audio-only path (0: off).
#   Also read as FA_KARA_MIN_LETTER_MS (deprecated).
# ECHORA_KARA_MIN_LETTER_MS=40
#   Also read as FA_KARA_MIN_TOKEN_MS (deprecated).
# ECHORA_KARA_MIN_TOKEN_MS=100
#   Shift of every time; 0 puts words on their sung onset.
#   Also read as FA_KARA_TIMING_OFFSET_MS (deprecated).
# ECHORA_KARA_TIMING_OFFSET_MS=0
#   Minimum durations follow each line's pace times this (0: fixed floor).
#   Also read as FA_KARA_DURATION_PACE_RATIO (deprecated).
# ECHORA_KARA_DURATION_PACE_RATIO=0.9
#   Extra cost per letter frame where the vocals are quiet (0: off).
#   Also read as FA_KARA_VOCAL_ACTIVITY_WEIGHT (deprecated).
# ECHORA_KARA_VOCAL_ACTIVITY_WEIGHT=2.0
#   on: load the MuQ branch; gate0: run without it (ablation); off: no fusion.
#   Also read as FA_KARA_FUSION (deprecated).
# ECHORA_KARA_FUSION=on
#   Label rules the model was trained with (worker/src/kara/aligner/label_rules.py).
#   Also read as FA_KARA_LABEL_RULES (deprecated).
# ECHORA_KARA_LABEL_RULES=v3-sung
#   Also read as FA_KARA_EXACT_FRAME_CLOCK (deprecated).
# ECHORA_KARA_EXACT_FRAME_CLOCK=true
#   Also read as FA_KARA_BLANK_FREE_TOKENS (deprecated).
# ECHORA_KARA_BLANK_FREE_TOKENS=true
#   Decode lines written in brackets on the backing-vocal head.
#   Also read as FA_KARA_BACKGROUND_DECODING (deprecated).
# ECHORA_KARA_BACKGROUND_DECODING=true
#   Weight of the text head's evidence (0: off, head not loaded).
#   Also read as FA_KARA_TEXT_BONUS (deprecated).
# ECHORA_KARA_TEXT_BONUS=0.4
#   Also read as FA_KARA_IN_LINE_GAP_COST (deprecated).
# ECHORA_KARA_IN_LINE_GAP_COST=0.2
#   Pull late words after silence to the first vocal energy (vocal stem only).
#   Also read as FA_KARA_GAP_ONSET_PULL (deprecated).
# ECHORA_KARA_GAP_ONSET_PULL=false
#   Place inline bracketed words on the backing-vocal head.
#   Also read as FA_KARA_INLINE_BACKING (deprecated).
# ECHORA_KARA_INLINE_BACKING=true
#   Also read as ECHORA_KARAOKE_JOB_TIMEOUT_SECONDS (deprecated).
# ECHORA_KARA_JOB_TIMEOUT_SECONDS=1800
#   Also read as ECHORA_KARAOKE_SHUTDOWN_GRACE_SECONDS (deprecated).
# ECHORA_KARA_SHUTDOWN_GRACE_SECONDS=10
#   Also read as ECHORA_KARAOKE_KILL_GRACE_SECONDS (deprecated).
# ECHORA_KARA_KILL_GRACE_SECONDS=5
#   Also read as ECHORA_KARAOKE_LOCK_POLL_SECONDS (deprecated).
# ECHORA_KARA_LOCK_POLL_SECONDS=0.25

# --- RecordingConfig: Recording search and calibration. Every name is ECHORA_RECORDING_<FIELD>.
#   Local bundle manifest (blank: search off).
# ECHORA_RECORDING_MODEL_MANIFEST=
# ECHORA_RECORDING_MODEL_ID=
# ECHORA_RECORDING_MODEL_REVISION=
# ECHORA_RECORDING_MODEL_DIRECTORY=/data/models/recording
#   Calibrated match policy file.
# ECHORA_RECORDING_MATCH_POLICY=
# ECHORA_RECORDING_INTRA_OP_THREADS=4
# ECHORA_RECORDING_INTER_OP_THREADS=1
# ECHORA_RECORDING_MAX_UPLOAD_BYTES=8388608
# ECHORA_RECORDING_MAX_ACTIVE=32
# ECHORA_RECORDING_MAX_ACTIVE_PER_USER=1
# ECHORA_RECORDING_UPLOADS_PER_MINUTE=6
# ECHORA_RECORDING_UPLOAD_READ_TIMEOUT_SECONDS=30
# ECHORA_RECORDING_DECODE_TIMEOUT_SECONDS=30
# ECHORA_RECORDING_PROCESSING_TIMEOUT_SECONDS=120
# ECHORA_RECORDING_CANCEL_POLL_SECONDS=0.25
# ECHORA_RECORDING_AUDIO_RETENTION_SECONDS=900
# ECHORA_RECORDING_RESULT_RETENTION_SECONDS=86400
# ECHORA_RECORDING_DIAGNOSTIC_RETENTION_SECONDS=86400
# ECHORA_RECORDING_CALIBRATION_ENABLED=false
# ECHORA_RECORDING_CALIBRATION_DIR=/data/recording-calibration
# ECHORA_RECORDING_CALIBRATION_MAX_USER_SAMPLES=20
# ECHORA_RECORDING_CALIBRATION_MAX_TOTAL_SAMPLES=200
# ECHORA_RECORDING_CALIBRATION_UPLOADS_PER_MINUTE=6
# ECHORA_RECORDING_CALIBRATION_RETENTION_SECONDS=604800

# --- ApiConfig: Cross-origin access to the API.
#   Comma-separated origins that may read responses.
# ECHORA_CORS_ORIGINS=

# --- SessionConfig: App sessions. Only explicit user activity moves the idle deadline.
# ECHORA_SESSION_TRUSTED_ORIGINS=
# ECHORA_SESSION_IDLE_TIMEOUT_SECONDS=604800
# ECHORA_SESSION_ABSOLUTE_TIMEOUT_SECONDS=2592000
# ECHORA_SESSION_RENEW_INTERVAL_SECONDS=3600
# ECHORA_SESSION_ACTIVITY_CHECK_SECONDS=60
# ECHORA_SESSION_ACTIVITY_WINDOW_SECONDS=300
# ECHORA_SESSION_REQUEST_TIMEOUT_SECONDS=10
#   Also read as COOKIE_SECURE (deprecated).
# ECHORA_SESSION_COOKIE_SECURE=false

# --- OidcConfig: Sign-in through an OpenID Connect provider.
#   Also read as OIDC_SESSION_SECRET (deprecated).
# ECHORA_OIDC_SESSION_SECRET=
#   Also read as OIDC_ISSUER_URL (deprecated).
# ECHORA_OIDC_ISSUER_URL=
#   Also read as OIDC_CLIENT_ID (deprecated).
# ECHORA_OIDC_CLIENT_ID=
#   Also read as OIDC_CLIENT_SECRET (deprecated).
# ECHORA_OIDC_CLIENT_SECRET=
#   Also read as OIDC_SCOPES (deprecated).
# ECHORA_OIDC_SCOPES=openid profile email
#   Also read as OIDC_REDIRECT_URI (deprecated).
# ECHORA_OIDC_REDIRECT_URI=
#   Also read as OIDC_POST_LOGIN_REDIRECT (deprecated).
# ECHORA_OIDC_POST_LOGIN_REDIRECT=http://localhost:3000/home
#   Also read as OIDC_REQUIRE_VERIFIED_EMAIL (deprecated).
# ECHORA_OIDC_REQUIRE_VERIFIED_EMAIL=false
#   Also read as OIDC_BOOTSTRAP_ADMIN_EMAIL (deprecated).
# ECHORA_OIDC_BOOTSTRAP_ADMIN_EMAIL=

# --- MediaCacheConfig: The Redis cache of cover art and other small media.
#   Also read as REDIS_URL (deprecated).
# ECHORA_MEDIA_CACHE_REDIS_URL=
# ECHORA_MEDIA_CACHE_TTL_SECONDS=3600
# ECHORA_MEDIA_CACHE_CONNECT_TIMEOUT_SECONDS=0.5
# ECHORA_MEDIA_CACHE_TIMEOUT_SECONDS=2

# --- UiConfig: Browser polling and timeouts, exported to the web app (``public_ui``).
# ECHORA_JOB_POLL_MS=1200
# ECHORA_BATCH_POLL_MS=1500
# ECHORA_HUM_INDEX_POLL_MS=2500
# ECHORA_RECORDING_POLL_MS=1500
# ECHORA_RECORDING_SEARCH_TIMEOUT_MS=120000
# ECHORA_RECORDING_REQUEST_TIMEOUT_MS=10000
# ECHORA_RECORDING_UPLOAD_TIMEOUT_MS=60000

# --- SearchConfig: Search services: how many searches run at once.
#   Searches (hum, recording, concepts) running at once.
# ECHORA_SEARCH_MAX_CONCURRENT=4
