FROM python:3.12.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /service
# ffmpeg follows the pinned Debian base image security repository.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg libchromaprint-tools espeak-ng \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 1001 echora
COPY services/analysis/pyproject.toml ./
RUN mkdir -p src/echora_analysis \
    && touch src/echora_analysis/__init__.py \
    && python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir . \
    && /opt/venv/bin/python -m nltk.downloader -d /usr/local/share/nltk_data cmudict \
    && rm -rf src
# Label rules v3 (vendor/fa_kara/label_rules.py, FA_KARA_LABEL_RULES=v3 only): per-line language with
# fastText lid.176.ftz (CC BY-SA 3.0), pinned by hash to the model the v3 manifest was built with.
RUN mkdir -p /opt/fa_kara_models \
    && /opt/venv/bin/python -c "import hashlib, urllib.request; data = urllib.request.urlopen('https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.ftz').read(); assert hashlib.sha256(data).hexdigest() == '8f3472cfe8738a7b6099e8e999c3cbfae0dcd15696aac7d7738a8039db603e83', 'lid.176.ftz hash'; open('/opt/fa_kara_models/lid.176.ftz', 'wb').write(data)"
COPY services/analysis/src ./src
COPY services/analysis/vendor ./vendor
COPY services/analysis/alembic.ini ./alembic.ini
COPY services/analysis/alembic ./alembic
# The GPU analysis image of this same build, which Modal runs (docs/modal-compute.md).
ARG ECHORA_MODAL_IMAGE=""
ENV ECHORA_MODAL_IMAGE="${ECHORA_MODAL_IMAGE:-ghcr.io/hackslashx/echora-analysis-gpu:latest}"
ENV PATH="/opt/venv/bin:$PATH" PYTHONPATH="/service/src" TORCH_HOME="/models/torch" LID_MODEL_PATH="/models/lid.176.bin" NLTK_DATA="/usr/local/share/nltk_data"
RUN mkdir -p /models/huggingface && chown -R echora /models
EXPOSE 8000
CMD ["sh", "-c", "mkdir -p /data/preprocessed /data/recording-calibration \"${ECHORA_MOTION_ARTWORK_DIR:-/data/motion-artwork}\" && chown echora /data/preprocessed /data/recording-calibration \"${ECHORA_MOTION_ARTWORK_DIR:-/data/motion-artwork}\" && chmod 700 /data/recording-calibration && chown -R echora /models && runuser -u echora -- python -m echora_analysis.download_models --prune-only && runuser -u echora -- alembic upgrade head && exec runuser -u echora -- uvicorn echora_analysis.main:app --host 0.0.0.0 --port 8000"]
